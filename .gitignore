*.swp
*.swo
*~
*.suo
*.user
*.userosscache
*.sln.docstates
.history/

# ---------- 操作系统 ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ---------- 日志与临时文件 ----------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp
*.bak
*.orig
*.rej
_probe.txt
tmp/
temp/

# ---------- 环境变量与密钥（绝不入库）----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
secrets/
*.keystore
!**/signing/*.md

# ---------- 测试与覆盖率 ----------
test-results/
playwright-report/
cypress/videos/
cypress/screenshots/
allure-results/

# ---------- 打包与安装器产物 ----------
*.exe
*.msi
*.msix
*.appx
*.dmg
*.pkg
*.AppImage
*.deb
*.rpm
*.snap
*.flatpak
*.asar
*.blockmap
*.nupkg
!scripts/**/*.ps1
!scripts/**/*.sh

# ---------- 数据库与运行时数据（本地优先，不入库）----------
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.db
*.db-wal
*.db-shm
*.mdb
data/
userdata/
backups/
snapshots/

# ---------- 大型二进制资源 ----------
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
# 例外：允许示例数据集以 LFS 或小体积形式入库
!docs/**/*.csv
!examples/**/*.csv

# ---------- 语言特定 ----------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
*.dll
*.so
*.dylib
*.o
*.a

# ---------- 本地 AI 模型（体积巨大，永不入库）----------
models/
*.gguf
*.ggml
*.onnx
*.safetensors
*.bin
!src/**/*.bin

# ---------- 备份与导出交付物 ----------
*.deskbase-backup
*.deskbase-export
deliverables/
