# ============================================================
# DeskBase (桌库) — 仓库忽略规则
# 目标：仓库只保留源码、文档与构建脚本；
#       本地参考资料、AI 交接文档、构建产物、用户数据一律不入库。
# ============================================================

# ---------- 本地专属文档（明确不上传仓库）----------
# 参考文档：竞品分析、选型调研、基准方法、合规清单等
local-docs/
# 兼容旧命名 / 其他可能的本地产物目录
reference-docs/
ai-handoff/
handoff/
# 用户本地笔记与临时文件
notes/
*.local.md
*.private.md

# ---------- 构建产物 ----------
dist/
build/
out/
release/
target/
*.tsbuildinfo
.gradle/
obj/
bin/
[Dd]ebug/
[Rr]elease/
x64/
*.exp
*.lib
*.pdb
*.ilk

# ---------- 依赖目录 ----------
node_modules/
bower_components/
jspm_packages/
.pnpm-store/
vendor/bundle/
__pypackages__/
.venv/
venv/
env/
.conda/
packages/*/node_modules/

